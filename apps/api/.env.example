# API environment — copy to .env.local for local dev
# Unset NODE_ENV means production (every safety control on). Local dev must say
# development explicitly; a production server must run with production.
NODE_ENV=development
PORT=4000
# Interface to listen on (API and customer-display socket). Default 127.0.0.1:
# only the reverse proxy reaches it. A counter PC serving LAN tablets: 0.0.0.0.
# HOST=127.0.0.1

# CORS — https://bayarealandscapingmaterials.com and https://www.bayarealandscapingmaterials.com
# are always allowed. Add other browser origins here, comma-separated (the
# counter PC's http://localhost:3000). In development any localhost/LAN origin works.
CORS_ORIGINS=http://localhost:3000

# Stripe Terminal — set these to switch payments from simulated → LIVE.
# Outside development the card routes refuse to run without the key.
# Get keys at dashboard.stripe.com; create a Terminal Location for the reader.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_TERMINAL_LOCATION=tml_xxx

# Database — MongoDB Atlas connection string (the sole persistence backend).
# Create a free cluster at https://www.mongodb.com/atlas, add your IP to the
# Network Access allow-list, and paste its SRV URI here (keep the DB name).
MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bay?appName=<app>

# First admin, seeded only into an empty users collection. There is no default
# password: without ADMIN_PASSWORD (12+ characters, letters and numbers) no
# admin is created. Admins sign in with the password; ADMIN_PIN is optional.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PIN=

# Demo data (sample vendors, fleet, orders and demo staff @balm.local) — only
# with SEED_DEMO=true, and refused in production. Demo staff use DEMO_PASSWORD.
# SEED_DEMO=false
# DEMO_PASSWORD=

# PIN sign-in for cashiers, trainees and drivers on a counter PC. Off by
# default (on in development); refused on production servers. Admins and
# managers always sign in with their password.
# ALLOW_PIN_LOGIN=false

# Customer-display socket on :3001 (staff sessions only). "off" on the cloud server.
# DISPLAY_SOCKET=on

# Production servers carry /etc/inerica/production; INERICA_PRODUCTION=1 says the
# same. There the API refuses to start unless NODE_ENV=production.
# INERICA_PRODUCTION=1

# Error tracking — when set, exceptions report to Sentry.
# SENTRY_DSN=

# Redis (Phase 2)
# REDIS_URL=redis://localhost:6379

# Auth (Phase 2)
# JWT_SECRET=
# COOKIE_SECRET=

# RingCentral SMS — set all four to switch messaging from simulated → LIVE.
# Create a server-to-server JWT app at developers.ringcentral.com (see
# docs/runbooks/ringcentral-setup.md). Scopes: SMS, ReadMessages, WebhookSubscriptions.
# RC_SERVER_URL=https://platform.ringcentral.com   # sandbox: https://platform.devtest.ringcentral.com
# RC_CLIENT_ID=
# RC_CLIENT_SECRET=
# RC_JWT=                       # the JWT credential string from the RC console
# RC_SMS_FROM=+15105550100      # your SMS-enabled RingCentral number (E.164)
# RC_WEBHOOK_URL=               # public https URL → POST /api/v1/messaging/webhook (no ?token=)
# RC_WEBHOOK_TOKEN=             # random secret (e.g. openssl rand -hex 24); RC sends it back in a
#                               # Verification-Token header. Required outside development.

# Telematics — set API_URL + API_KEY to poll a live GPS provider (Samsara/Geotab/etc);
# unset = simulated random-walk for the demo. INGEST_TOKEN gates POST /fleet/telematics
# (devices/platforms push position batches there with header x-telematics-token).
# TELEMATICS_API_URL=
# TELEMATICS_API_KEY=
# TELEMATICS_POLL_MS=15000
# TELEMATICS_INGEST_TOKEN=

# Google Gemini (Phase 5)
# GEMINI_API_KEY=

# Email (Phase 2)
# RESEND_API_KEY=

# Owner phone (E.164) texted on each new website lead so none are missed.
# LEAD_NOTIFY_SMS=+15102554886
