# Public site environment — copy to .env.local for local dev.
#
# NEXT_PUBLIC_* values are baked into the bundle by `next build`, which reads
# .env.production.local, .env.local, .env.production and .env — never
# .env.development*. Values kept only in a development file are silently
# missing from a production build (no tags, no maps, leads posted to :4000).
NEXT_PUBLIC_SITE_URL=https://bayarealandscapingmaterials.com
# Also the only API origin the Content-Security-Policy allows (next.config.ts).
# Set it for every internet-facing build.
NEXT_PUBLIC_API_URL=https://bayarealandscapingmaterials.com

# ── Google Maps ───────────────────────────────────────────────────────
# Browser key — powers the address selector (/request-quote) and the store
# locator (/service-area). It ships in the page source, so lock it down in GCP:
# Application restriction = HTTP referrers (your domains + localhost), and
# API restriction = Maps JavaScript API + Places API (New).
# Enable in Google Cloud: Maps JavaScript API, Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional. Cloud-styled vector Map ID. Unset falls back to Google's DEMO_MAP_ID,
# which works but shows default styling. Create one under Google Maps Platform →
# Map Management to brand the map.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional but recommended. SERVER-ONLY key (no NEXT_PUBLIC_ prefix — never sent
# to the browser) used by /api/maps/distance to call the Routes API for real
# driving distances. Restrict it by IP, and to the Routes API only.
# If unset, the route answers 503 and the locator quietly degrades to
# straight-line distance. The browser key above is never used for it.
# Enable in Google Cloud: Routes API, and Places API (New) for the reviews below.
GOOGLE_MAPS_SERVER_KEY=

# The yard's Google Place ID (Place ID Finder in Google's Maps docs). With it,
# the home page shows the yard's real Google rating and three reviews,
# refreshed daily, read server-side with the key above. Unset = no reviews block.
GOOGLE_PLACE_ID=

# Fleet map tiles — defaults to OpenStreetMap (keyless). Override with a provider
# template URL (Mapbox/Stadia/etc), e.g. https://.../{z}/{x}/{y}.png?key=...
# The tile host is added to the staff-screen CSP at build time.
NEXT_PUBLIC_MAP_TILE_URL=

# Analytics (optional)
NEXT_PUBLIC_UMAMI_ENDPOINT=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Google Tag Manager ────────────────────────────────────────────────
# GTM container ID. This is the ONLY Google ID that lives in the environment —
# every other one (the Google tag GT-NGWMLXJL, the GA4 and Ads destinations, the
# conversion labels) is in lib/google-tags.ts, because there is exactly one BALM
# account and a typo here would send conversions nowhere.
#
# Set    → GTM loads the container (public pages only, with Consent Mode
#          defaults denied until the visitor accepts), which holds the Google tag
#          on Initialization — All Pages. Add NO separate GA4 config, NO separate
#          Ads config, and NO Conversion Linker: the Google tag fans out to both
#          destinations server-side already.
# Blank  → no tag loads at all (dev/preview builds). There is no direct-gtag
#          fallback.
#
# Inlined at build time — set it BEFORE `next build`, not just at runtime.
# Production value: GTM-5MXCJBSJ (account "Tyagi Group").
NEXT_PUBLIC_GTM_ID=GTM-5MXCJBSJ

# Local hardware bridge (thermal printer + cash drawer) — apps/bridge.
# Also allowed in the staff-screen CSP at build time.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:9110
