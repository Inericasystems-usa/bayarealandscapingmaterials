# BALM production settings on Host A: variable NAMES only. Values come from the
# owner and live only on the server (mode 600), never in git:
#   /var/www/bayarealandscapingmaterials.com-shared/web.env -> apps/web/.env.production.local
#   /var/www/bayarealandscapingmaterials.com-shared/api.env -> apps/api/.env
# scripts/deploy-production.sh links both into every release.
#
# Set by ecosystem.config.cjs, which wins over these files, so leave them out:
#   NODE_ENV HOST PORT DISPLAY_SOCKET SEED_DEMO INERICA_PRODUCTION NEXT_TELEMETRY_DISABLED

# ── web.env ─────────────────────────────────────────────────────────────────
# Read by `next build`, which compiles every NEXT_PUBLIC_* value into the public
# pages (change one, rebuild), and by `next start`. next build does NOT read
# .env.development or .env.development.local: values kept only there vanish
# from the production site.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_BRIDGE_URL=
NEXT_PUBLIC_POS_EDITION=
# Label of the Google Ads "Contact form lead" action, once the owner creates it
# (DEPLOY.md, section 12). Unset: the contact event carries no Ads label.
NEXT_PUBLIC_ADS_CONTACT_LABEL=
# Server only, never NEXT_PUBLIC_:
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_PLACE_ID=
API_INTERNAL_URL=
# Never set NEXT_PUBLIC_BRIDGE_TOKEN: each counter PC pairs with its bridge
# (apps/bridge/README.md).

# ── api.env ─────────────────────────────────────────────────────────────────
# Read by the API when it starts (apps/api/src/config.ts). Never on this server:
# DEMO_PASSWORD, ALLOW_PIN_LOGIN, MFA_OPTIONAL_IN_DEVELOPMENT (with =true the
# API refuses to start). Admins and managers always use two-step sign-in here.
# RC_WEBHOOK_TOKEN is required for inbound SMS: without it webhooks are refused.
# MONGODB_URL must point at a replica set (DEPLOY.md, section 9): the API refuses
# a standalone server unless MONGODB_ALLOW_STANDALONE=true, which leaves writes
# that belong together non-atomic; leave that unset.
MONGODB_URL=
# Required: the API refuses to start without it. `openssl rand -hex 32`. Keep a
# copy apart from the database backups: without it the encrypted fields are lost.
DATA_ENCRYPTION_KEY=
# rclone remote for the off-host copy of the nightly backup, e.g. b2:balm-backups/mongo
# (scripts/backup-mongo.sh reads it from here; the API ignores it).
BACKUP_REMOTE=
CORS_ORIGINS=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TERMINAL_LOCATION=
RC_SERVER_URL=
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_SMS_FROM=
RC_WEBHOOK_URL=
RC_WEBHOOK_TOKEN=
LEAD_NOTIFY_SMS=
# Google Ads scheduled upload of offline conversions (DEPLOY.md, section 12).
# Off unless both are set; the password needs 32+ characters: `openssl rand -hex 24`.
OFFLINE_CONVERSIONS_FEED_USER=
OFFLINE_CONVERSIONS_FEED_PASSWORD=
TELEMATICS_API_URL=
TELEMATICS_API_KEY=
TELEMATICS_POLL_MS=
TELEMATICS_INGEST_TOKEN=
# First boot of an empty database only (creates the admin); delete afterwards:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PIN=
