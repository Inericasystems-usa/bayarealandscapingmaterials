{
  "name": "balm-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Bay Area Landscaping Materials — unified platform (public site + POS + admin + driver app + CEO portal)",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "preinstall": "node -e \"const a=process.env.npm_config_user_agent||'';if(a&&!a.startsWith('pnpm/')){console.error('This repository installs with pnpm only (package.json packageManager): corepack enable && pnpm install');process.exit(1)}\"",
    "dev": "node scripts/assert-not-production.mjs && turbo run dev --parallel",
    "start": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "deploy:check": "node scripts/check-production.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write .",
    "handover:verify": "node scripts/verify-handover.mjs",
    "handover:pack": "node scripts/verify-handover.mjs && git archive --format=tar.gz -o balm-handover.tar.gz HEAD && echo \"Wrote balm-handover.tar.gz (tracked files only — no .env, node_modules, dist, .next, data).\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "globals": "^17.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.11"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "plugins": []
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "sharp": "^0.35.5",
      "postcss": "^8.5.29",
      "nanoid@<4": "^3.3.18",
      "source-map-js": "^1.2.2",
      "dompurify": "^3.4.16",
      "fast-copy@<4": "^3.1.0",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=4 <6": "^5.0.12",
      "js-yaml@>=4 <5": "^4.3.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0"
    }
  }
}
