{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React library",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true
  },
  "include": ["src/**/*"]
}
